# Local development template; never commit real values.
APP_ENV=development
SECRET_KEY=

# Persistent JWT signing secret. Production requires independent random values
# of at least 32 characters; configure as private Render environment values.
JWT_SECRET_KEY=

# Local SQLite. On Render use Supabase Session Pooler (port 5432),
# postgresql+psycopg://.../postgres?sslmode=require; never commit the URL.
DATABASE_URL=sqlite:///resqnet.db

# OpenWeatherMap API Key for live weather and preparedness center
OPENWEATHER_API_KEY=
# Optional server-side guidance chat. Keep the key in backend environment only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Flask Environment (development or production)
SEED_DEMO_DATA=False
DEMO_MODE=False
ADMIN_SECRET_CODE=
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://resqnet1-2026.netlify.app

# Enable or disable debug mode
FLASK_DEBUG=False

# Local files only. Render Free must use STORAGE_BACKEND=supabase.
STORAGE_BACKEND=local
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760
PERSISTENT_STORAGE_PATH=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
# Optional specialist module; blank keeps it disabled.
FLOOD_API_BASE_URL=

# Render: use the private Key Value internal Redis URL in the same region.
RATELIMIT_STORAGE_URI=memory://
# Zero for direct local requests. Verify the trusted proxy chain before Render use.
TRUSTED_PROXY_HOPS=0

# Optional OSM search/reverse lookup service. Keep the default public endpoint
# only for moderate traffic; production should set a contactable app User-Agent.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ResQNet/1.0
